# Edu Mentor AI — Environment Variables
# Copy to .env and fill in values

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Backend
APP_ENV=development
CORS_ORIGINS=http://localhost:3000

# LLM (llama.cpp) — lower MAX_TOKENS / CONTEXT for faster CPU replies
LLM_MODEL_PATH=./data/models/qwen3.gguf
LLM_CONTEXT_LENGTH=1536
LLM_MAX_TOKENS=192
LLM_MAX_TOKENS_VOICE=128
LLM_N_THREADS=4
LLM_N_BATCH=512

# Embeddings
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=ml_content

# PostgreSQL
DATABASE_URL=postgresql://edu_mentor:edu_mentor_dev@localhost:5432/edu_mentor_ai

# Voice
WHISPER_MODEL=tiny
RAG_TOP_K=2
PIPER_VOICE=en_US-lessac-medium

# macOS: avoid OpenMP duplicate library crash with ML packages
# KMP_DUPLICATE_LIB_OK=TRUE

# Auth (Phase 5)
JWT_SECRET=change-me-in-production
JWT_EXPIRY_HOURS=24
